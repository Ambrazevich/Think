    <style name="ResultItemText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif</item>
    </style>
    <style name="SettingsSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="SettingsWheelLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Theme.Think" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/game_primary</item>
        <item name="colorPrimaryVariant">@color/game_primary_variant</item>
        <item name="colorOnPrimary">@color/black</item> 
        
        <item name="colorSecondary">@color/game_secondary</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:textColor">@color/text_primary</item>

        
        <item name="android:statusBarColor">@color/game_background</item>
        
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>

        
        <item name="android:windowBackground">@color/game_background</item>

        
        <item name="fontFamily">sans-serif</item>
    </style>
    <style name="Theme.Think.Settings" parent="Theme.Think">
        <item name="colorSecondary">@color/settings_accent_color</item>
    </style>
    <style name="ThinkButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/game_primary</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAllCaps">false</item> 
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">24dp</item> 
        <item name="fontFamily">sans-serif-medium</item>
        
        <item name="elevation">4dp</item>
    </style>
    <style name="ThinkKeypadButtonDark" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">26sp</item>
        <item name="cornerRadius">16dp</item> 
        <item name="android:backgroundTint">@color/game_surface</item> 
        <item name="android:textColor">@color/keypad_text_color</item> 
        <item name="fontFamily">sans-serif-medium</item>
        <item name="elevation">2dp</item>
    </style>
    <style name="ThinkKeypadButtonLight" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:textSize">26sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:backgroundTint">@color/game_secondary</item> 
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">sans-serif-black</item>
    </style>
    <style name="ThinkMainMenuButton" parent="ThinkButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:layout_margin">8dp</item> 
    </style>
    <style name="ThinkNumberPickerTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="android:textColorPrimary">@color/settings_accent_color</item>
        <item name="android:textColorSecondary">@color/settings_accent_color</item> 
        <item name="android:textColor">@color/settings_accent_color</item>
        <item name="android:textSize">16sp</item>
        
        
        <item name="colorControlNormal">@color/settings_accent_color</item>
        <item name="colorControlActivated">@color/settings_accent_color</item>
        <item name="android:editTextColor">@color/settings_accent_color</item>
    </style>
