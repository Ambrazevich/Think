<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/milk_white"
    android:padding="16dp"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Difficulty and Time Spinners -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    style="@style/SettingsWheelLabel"
                    android:text="@string/difficulty" />
                <Spinner
                    android:id="@+id/spinnerDifficulty"
                    style="@style/SettingsSpinner"
                    android:layout_width="match_parent"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    style="@style/SettingsWheelLabel"
                    android:text="@string/time" />
                <Spinner
                    android:id="@+id/spinnerTime"
                    style="@style/SettingsSpinner"
                    android:layout_width="match_parent"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Operation Switches -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/operations"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAddition"
            style="@style/SettingsSwitch"
            android:text="@string/addition" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSubtraction"
            style="@style/SettingsSwitch"
            android:text="@string/subtraction" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchMultiplication"
            style="@style/SettingsSwitch"
            android:text="@string/multiplication" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchDivision"
            style="@style/SettingsSwitch"
            android:text="@string/division" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPower"
            style="@style/SettingsSwitch"
            android:text="@string/power" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSquareRoot"
            style="@style/SettingsSwitch"
            android:text="@string/square_root" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCommonFractions"
            style="@style/SettingsSwitch"
            android:text="@string/common_fractions" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchDecimalFractions"
            style="@style/SettingsSwitch"
            android:text="@string/decimal_fractions" />

    </LinearLayout>
</ScrollView>
