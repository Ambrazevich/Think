<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Think" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/game_primary</item>
        <item name="colorPrimaryVariant">@color/game_primary_variant</item>
        <item name="colorOnPrimary">@color/black</item> <!-- Черный текст на ярких кнопках -->
        
        <item name="colorSecondary">@color/game_secondary</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:textColor">@color/text_primary</item>

        <!-- Status bar color (Matching background for immersion) -->
        <item name="android:statusBarColor">@color/game_background</item>
        <!-- False means icons will be light (white), suitable for dark background -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- App background -->
        <item name="android:windowBackground">@color/game_background</item>

        <!-- Default Font -->
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Base custom button style - Modern "Pill" Shape -->
    <style name="ThinkButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/game_primary</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAllCaps">false</item> <!-- "Start Game" вместо "START GAME" -->
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">24dp</item> <!-- Сильное скругление -->
        <item name="fontFamily">sans-serif-medium</item>
        <!-- Тень для глубины -->
        <item name="elevation">4dp</item>
    </style>

    <!-- Style for the main menu buttons -->
    <style name="ThinkMainMenuButton" parent="ThinkButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:layout_margin">8dp</item> <!-- Отступы между кнопками -->
    </style>

    <style name="ResultItemText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Keypad Button Styles - Modernized -->
    <style name="ThinkKeypadButtonDark" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">26sp</item>
        <item name="cornerRadius">16dp</item> <!-- Мягкий квадрат -->
        <item name="android:backgroundTint">@color/game_surface</item> <!-- Темные кнопки цифр -->
        <item name="android:textColor">@color/keypad_text_color</item> <!-- Цветной текст цифр -->
        <item name="fontFamily">sans-serif-medium</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="ThinkKeypadButtonLight" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:textSize">26sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:backgroundTint">@color/game_secondary</item> <!-- Акцентные кнопки (Clear/Enter) -->
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">sans-serif-black</item>
    </style>

    <!-- Settings Screen Styles -->
    <style name="SettingsWheelLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SettingsSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Theme for SettingsActivity to override secondary color in Day Mode -->
    <style name="Theme.Think.Settings" parent="Theme.Think">
        <item name="colorSecondary">@color/settings_accent_color</item>
    </style>

    <!-- Theme Overlay to force NumberPicker text color -->
    <style name="ThinkNumberPickerTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Main text color -->
        <item name="android:textColorPrimary">@color/settings_accent_color</item>
        <item name="android:textColorSecondary">@color/settings_accent_color</item> <!-- Unselected text -->
        <item name="android:textColor">@color/settings_accent_color</item>
        <item name="android:textSize">16sp</item>
        
        <!-- Divider color -->
        <item name="colorControlNormal">@color/settings_accent_color</item>
        <item name="colorControlActivated">@color/settings_accent_color</item>
        <item name="android:editTextColor">@color/settings_accent_color</item>
    </style>
</resources>