<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThinkBaseTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/game_primary</item>
        <item name="colorPrimaryVariant">@color/game_primary_variant</item>
        <item name="colorOnPrimary">@color/game_on_primary</item>
        <item name="colorSecondary">@color/game_primary</item>
        <item name="colorSecondaryVariant">@color/game_primary_variant</item>
        <item name="colorOnSecondary">@color/game_on_primary</item>
        <item name="colorSurface">@color/game_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/game_error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="android:colorAccent">@color/game_primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/game_primary</item>
        <item name="colorControlHighlight">@color/ripple_primary</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:windowBackground">@color/game_background</item>
        <item name="android:statusBarColor">@color/game_background</item>
        <item name="android:navigationBarColor">@color/game_background</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Think.MaterialAlertDialog</item>
    </style>

    <style name="ThinkSystemBarsTheme" parent="@style/ThinkBaseTheme">
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>

    <style name="Theme.Think" parent="@style/ThinkSystemBarsTheme" />

    <style name="Theme.Think.Settings" parent="Theme.Think" />

    <style name="ThemeOverlay.Think.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/game_primary</item>
        <item name="colorSurface">@color/game_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/ThinkDialogShape</item>
    </style>

    <style name="ThinkDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ThinkScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">20sp</item>
        <item name="android:autoSizeMaxTextSize">30sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="ThinkCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/game_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="ThinkButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">14sp</item>
        <item name="android:autoSizeMaxTextSize">17sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="rippleColor">@color/ripple_neutral</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ThinkButton.Secondary" parent="ThinkButton">
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="backgroundTint">@color/button_secondary_background</item>
        <item name="strokeColor">@color/outline_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <style name="ThinkButton.Danger" parent="ThinkButton.Secondary">
        <item name="android:textColor">@color/game_error</item>
        <item name="backgroundTint">@color/button_danger_background</item>
        <item name="strokeColor">@color/game_error</item>
        <item name="rippleColor">@color/ripple_error</item>
    </style>

    <style name="ThinkMainMenuButton" parent="ThinkButton">
        <item name="android:textSize">19sp</item>
        <item name="android:autoSizeMaxTextSize">19sp</item>
    </style>

    <style name="ThinkMainMenuButton.Secondary" parent="ThinkButton.Secondary">
        <item name="android:textSize">18sp</item>
        <item name="android:autoSizeMaxTextSize">18sp</item>
    </style>

    <style name="ResultItemText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ThinkKeypadButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">25sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">14sp</item>
        <item name="android:autoSizeMaxTextSize">25sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ThinkKeypadButtonDark" parent="ThinkKeypadButton">
        <item name="android:textColor">@color/button_key_text</item>
        <item name="backgroundTint">@color/button_key_background</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple_neutral</item>
    </style>

    <style name="ThinkKeypadButtonLight" parent="ThinkKeypadButton">
        <item name="android:textColor">@color/button_action_text</item>
        <item name="backgroundTint">@color/button_action_background</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <style name="ThinkKeypadButtonPrimary" parent="ThinkKeypadButton">
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="rippleColor">@color/ripple_neutral</item>
    </style>

    <style name="SettingsWheelLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/settings_picker_text_size</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SettingsSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">false</item>
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="ThinkNumberPickerTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textColorPrimary">@color/game_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColor">@color/game_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="colorControlNormal">@color/outline_soft</item>
        <item name="colorControlActivated">@color/game_primary</item>
        <item name="android:editTextColor">@color/game_primary</item>
    </style>
</resources>
