<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    tools:context=".SettingsActivity">

    <TextView
        android:id="@+id/textViewSettingsTitle"
        style="@style/ThinkScreenTitle"
        android:text="@string/settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewSettingsTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/ThinkCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsWheelLabel"
                            android:text="@string/level" />
                        <io.github.ambrazevich.think.gameutils.ScrollableNumberPicker
                            android:id="@+id/numberPickerDifficulty"
                            android:layout_width="match_parent"
                            android:layout_height="144dp"
                            android:descendantFocusability="blocksDescendants"
                            android:solidColor="@color/game_surface"
                            android:theme="@style/ThinkNumberPickerTheme" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsWheelLabel"
                            android:text="@string/time" />
                        <io.github.ambrazevich.think.gameutils.ScrollableNumberPicker
                            android:id="@+id/numberPickerTime"
                            android:layout_width="match_parent"
                            android:layout_height="144dp"
                            android:descendantFocusability="blocksDescendants"
                            android:solidColor="@color/game_surface"
                            android:theme="@style/ThinkNumberPickerTheme" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingsWheelLabel"
                            android:text="@string/language" />
                        <io.github.ambrazevich.think.gameutils.ScrollableNumberPicker
                            android:id="@+id/numberPickerLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="144dp"
                            android:descendantFocusability="blocksDescendants"
                            android:solidColor="@color/game_surface"
                            android:theme="@style/ThinkNumberPickerTheme" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/ThinkSectionTitle"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="@string/operations" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ThinkCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/settings_divider"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAddition"
                        style="@style/SettingsSwitch"
                        android:text="@string/addition" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSubtraction"
                        style="@style/SettingsSwitch"
                        android:text="@string/subtraction" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMultiplication"
                        style="@style/SettingsSwitch"
                        android:text="@string/multiplication" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDivision"
                        style="@style/SettingsSwitch"
                        android:text="@string/division" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPower"
                        style="@style/SettingsSwitch"
                        android:text="@string/power" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSquareRoot"
                        style="@style/SettingsSwitch"
                        android:text="@string/square_root" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchCommonFractions"
                        style="@style/SettingsSwitch"
                        android:text="@string/common_fractions" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDecimalFractions"
                        style="@style/SettingsSwitch"
                        android:text="@string/decimal_fractions" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        style="@style/SettingsSwitch"
                        android:text="@string/dark_mode" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
