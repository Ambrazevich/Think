<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:padding="16dp"
    tools:context=".SettingsActivity">

    <!-- Removed Title "Settings" as requested -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Game Config Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/game_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:contentPadding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            style="@style/SettingsWheelLabel"
                            android:text="@string/level" />
                        
                        <io.github.ambrazevich.think.gameutils.ScrollableNumberPicker
                            android:id="@+id/numberPickerDifficulty"
                            android:layout_width="wrap_content"
                            android:layout_height="160dp"
                            android:theme="@style/ThinkNumberPickerTheme" 
                            android:solidColor="@color/game_surface"
                            android:descendantFocusability="blocksDescendants"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            style="@style/SettingsWheelLabel"
                            android:text="@string/time" />
                        <io.github.ambrazevich.think.gameutils.ScrollableNumberPicker
                            android:id="@+id/numberPickerTime"
                            android:layout_width="wrap_content"
                            android:layout_height="160dp"
                            android:theme="@style/ThinkNumberPickerTheme"
                            android:solidColor="@color/game_surface"
                            android:descendantFocusability="blocksDescendants"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            style="@style/SettingsWheelLabel"
                            android:text="@string/language" />
                        <io.github.ambrazevich.think.gameutils.ScrollableNumberPicker
                            android:id="@+id/numberPickerLanguage"
                            android:layout_width="wrap_content"
                            android:layout_height="160dp"
                            android:theme="@style/ThinkNumberPickerTheme"
                            android:solidColor="@color/game_surface"
                            android:descendantFocusability="blocksDescendants"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Removed Title "Operations" as requested -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/game_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAddition"
                        style="@style/SettingsSwitch"
                        android:text="@string/addition" />

                    
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSubtraction"
                        style="@style/SettingsSwitch"
                        android:text="@string/subtraction" />


                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMultiplication"
                        style="@style/SettingsSwitch"
                        android:text="@string/multiplication" />


                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDivision"
                        style="@style/SettingsSwitch"
                        android:text="@string/division" />


                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPower"
                        style="@style/SettingsSwitch"
                        android:text="@string/power" />


                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSquareRoot"
                        style="@style/SettingsSwitch"
                        android:text="@string/square_root" />


                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchCommonFractions"
                        style="@style/SettingsSwitch"
                        android:text="@string/common_fractions" />


                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDecimalFractions"
                        style="@style/SettingsSwitch"
                        android:text="@string/decimal_fractions" />


                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        style="@style/SettingsSwitch"
                        android:text="@string/dark_mode" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
