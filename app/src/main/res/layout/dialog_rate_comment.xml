<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rate_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/game_surface">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rate_title"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:id="@+id/stars_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/star1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/star_1_desc"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"
            android:padding="4dp"
            app:tint="@color/game_secondary"/>

        <ImageView
            android:id="@+id/star2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/star_2_desc"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"
            android:padding="4dp"
            app:tint="@color/game_secondary"/>

        <ImageView
            android:id="@+id/star3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/star_3_desc"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"
            android:padding="4dp"
            app:tint="@color/game_secondary"/>

        <ImageView
            android:id="@+id/star4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/star_4_desc"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"
            android:padding="4dp"
            app:tint="@color/game_secondary"/>

        <ImageView
            android:id="@+id/star5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/star_5_desc"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"
            android:padding="4dp"
            app:tint="@color/game_secondary"/>
    </LinearLayout>

    <EditText
        android:id="@+id/commentEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:importantForAutofill="no"
        android:hint="@string/rate_hint"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:background="@drawable/input_background_shape"
        android:maxLines="5"/>
        <!-- Note: referencing input_background_shape again. I need to make sure it exists or the app will crash. 
             If it doesn't exist, I'll create a simple shape xml. -->

    <TextView
        android:id="@+id/helperText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/game_error"
        android:textSize="12sp"
        android:paddingTop="8dp"
        android:visibility="gone"/>

</LinearLayout>
