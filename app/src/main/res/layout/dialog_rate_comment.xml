<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rate_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rate this app"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:id="@+id/stars_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/star1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="star 1"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"
            android:padding="4dp"/>

        <ImageView
            android:id="@+id/star2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="star 2"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"/>

        <ImageView
            android:id="@+id/star3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="star 3"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"
            android:padding="4dp"/>

        <ImageView
            android:id="@+id/star4"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="star 4"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"
            android:padding="4dp"/>

        <ImageView
            android:id="@+id/star5"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="star 5"
            android:src="@android:drawable/star_big_off"
            android:adjustViewBounds="true"
            android:padding="4dp"/>
    </LinearLayout>

    <EditText
        android:id="@+id/commentEdit"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="Write a comment (optional)"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:padding="8dp"
        android:background="@android:drawable/edit_text"
        android:maxLines="6"
        android:overScrollMode="always"/>

    <TextView
        android:id="@+id/helperText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:textAppearance="?android:attr/textAppearanceSmall"
        android:paddingTop="8dp"/>
</LinearLayout>